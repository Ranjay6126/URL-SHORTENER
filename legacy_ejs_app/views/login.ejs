<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login</title>

  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%234f46e5%22/><text x=%2250%22 y=%2265%22 text-anchor=%22middle%22 font-size=%2250%22 font-family=%22sans-serif%22 fill=%22white%22 font-weight=%22bold%22>S</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/login.css" />
</head>
<body>
  <main class="auth-card">
    <div class="auth-logo"></div>
    <h1>Welcome back</h1>
    <p class="auth-sub">Login to manage your short links</p>

    <% if (locals.error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <form action="/user/login" method="post">
      <div class="input-group">
        <label for="email">Email</label>
        <input id="email" type="email" required name="email" placeholder="you@example.com" />
      </div>

      <div class="input-group">
        <label for="password">Password</label>
        <input id="password" type="password" required name="password" placeholder="••••••••" />
      </div>

      <button type="submit">Sign In</button>
    </form>

    <p class="switch-auth">New here? <a href="/signup">Create an account</a></p>
  </main>

  <p class="footer-text">Crafted with care by Ranjay</p>
</body>
</html>
