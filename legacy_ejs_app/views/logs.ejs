<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Server Logs</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔗</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/logs.css" />
  </head>
  <body>
    <%
      const pageData = JSON.stringify({
        lines: locals.lines || [],
        total: locals.total || 0,
      }).replace(/</g, "\\u003c");
    %>

    <!-- NAVBAR (server rendered by EJS) -->
    <nav class="navbar">
      <a class="brand" href="/"><span class="logo">✂️</span> URL Shortener 🔗</a>
      <div class="nav-right">
        <span class="admin-chip">🛡️ Admin</span>
        <a class="btn-nav" href="/">← Home</a>
      </div>
    </nav>

    <main class="container">
      <div class="head-row">
        <div>
          <h1>📜 Server Logs</h1>
          <p class="sub">
            Every request is recorded with its IP address and timestamp.
            Visible only to <b><%= locals.adminEmail || 'the admin' %></b>.
          </p>
        </div>
        <!-- React mounts the Refresh / Download / Clear actions here -->
        <div id="root-actions"></div>
      </div>

      <!-- React mounts the stats cards + log list here -->
      <div id="root"></div>
    </main>

    <footer class="footer">Server logs · Crafted with ❤️ by Ranjay</footer>

    <!-- ====== page data for React (JSON island, XSS-safe) ====== -->
    <script id="__DATA__" type="application/json"><%- pageData %></script>

    <!-- React 18 UMD + Babel (served locally from node_modules) -->
    <script crossorigin src="/vendor/react/react.production.min.js"></script>
    <script crossorigin src="/vendor/react-dom/react-dom.production.min.js"></script>
    <script src="/vendor/babel/babel.min.js"></script>
    <script type="text/babel" src="/react/LogsApp.jsx"></script>
  </body>
</html>
